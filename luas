-- ===================================================
-- KONFIGURASI KOORDINAT UTAMA
-- ===================================================
local BASE_X = 77
local BASE_Y = 35

local validEmotes = {
    ["/no"] = true,
    ["/yes"] = true,
    ["/love"] = true,
    ["/furious"] = true,
    ["/idk"] = true,
    ["/sleep"] = true,
    ["/rolleyes"] = true,
    ["/fp"] = true,
    ["/wave"] = true,
    ["/omg"] = true,
    ["/dance"] = true,
    ["/fold"] = true
}

local mirror_emote = true
local emoteCooldown = false

-- ===================================================
-- HELPER FUNCTION: AMBIL INDEX BOT SECARA AMAN (SAFE MATH)
-- ===================================================
local function getSafeBotIndex(botObj, fallbackIndex)
    if botObj ~= nil and type(botObj.index) == "number" and botObj.index > 0 then
        return botObj.index
    end
    return fallbackIndex or 1
end

-- ===================================================
-- THREAD MULTIBOT AUTO-HIT
-- ===================================================
runThread(function()
    while true do
        -- Mengambil tabel seluruh bot yang aktif
        local allBots = getBots()
        
        for i, b in ipairs(allBots) do
            if b ~= nil and b:isInWorld() then
                -- Mendapatkan index bot dengan aman
                local botIdx = getSafeBotIndex(b, i)
                
                -- Dynamic Tile Assignment (1 Bot = 1 Tile):
                -- Bot 1 -> Stand di (77, 35) | Hit (77, 36)
                -- Bot 2 -> Stand di (77, 36) | Hit (77, 37)
                -- Bot 3 -> Stand di (77, 37) | Hit (77, 38)
                local targetX = BASE_X
                local targetY = BASE_Y + (botIdx - 1)
                
                -- Memukul 1 tile di bawah posisi berdiri bot (targetY + 1)
                b:hit(targetX, targetY + 1)
            end
        end
        
        sleep(5000) -- Delay siklus hit setiap 5 detik
    end
end)

-- ===================================================
-- CALLBACK EVENT AUTO-EMOTE & TELEPORT
-- ===================================================
function onVariant(varlist, netid)
    local bot = getBot() -- Bot lokal context
    
    if bot ~= nil and mirror_emote and varlist:get(0):getString() == "OnAction" then
        local emote = varlist:get(1):getString()
        
        if validEmotes[emote] and not emoteCooldown then
            emoteCooldown = true
            
            print("[" .. bot.name .. "] Emote detected: " .. emote)
            
            -- 1. Bot mengirimkan emote balik via bot:say()
            bot:say(emote)
            
            -- 2. Langsung Teleport ke Tile Khusus milik bot ini
            if bot:isInWorld() then
                local botIdx = getSafeBotIndex(bot, 1)
                local myX = BASE_X
                local myY = BASE_Y + (botIdx - 1)
                
                bot:moveTile(myX, myY)
            end
            
            -- Cooldown listener 3 detik agar tidak spam
            runThread(function()
                sleep(3000)
                emoteCooldown = false
            end)
        end
    end
end

-- ===================================================
-- REGISTER EVENT & LISTEN
-- ===================================================
addEvent(Event.variantlist, onVariant)

-- Menjaga event listener aktif selama 24 jam (86400 detik)
listenEvents(86400)
