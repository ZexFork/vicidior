}

local mirror_emote = true
local emoteCooldown = false

local function getBotIndex(botObj, loopIndex)
    if botObj ~= nil and type(botObj.index) == "number" and botObj.index > 0 then
        return botObj.index
    end
    return loopIndex or 1
end

runThread(function()
    while true do
        local bots = getBots()
        
        for i, b in ipairs(bots) do
            if b ~= nil and b:isInWorld() then
                local idx = getBotIndex(b, i)
                local tileX = BASE_X
                local tileY = BASE_Y + (idx - 1)
                
                b:hit(tileX, tileY + 1)
            end
        end
        
        sleep(5000)
    end
end)

